{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PROTEUS",
  "version": "0.3.0",
  "identifier": "dev.proteus-int.desktop",
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["proteus"]
      }
    }
  },
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "PROTEUS",
        "width": 1376,
        "height": 800,
        "minWidth": 640,
        "minHeight": 600,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost; connect-src ipc: http://ipc.localhost; font-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "icon": ["icons/icon.png", "icons/icon.icns", "icons/icon.ico"],
    "fileAssociations": [
      {
        "ext": ["proteus"],
        "name": "PROTEUS Persona Preset",
        "description": "PROTEUS persona preset",
        "mimeType": "application/x-proteus",
        "role": "Editor",
        "exportedType": {
          "identifier": "dev.proteus-int.personas",
          "conformsTo": ["public.json"]
        }
      }
    ],
    "linux": {
      "deb": {
        "depends": ["shared-mime-info", "xdg-utils"],
        "files": {
          "/usr/share/mime/packages/proteus.xml": "file-associations/proteus.xml"
        },
        "desktopTemplate": "file-associations/proteus.desktop"
      }
    },
    "resources": ["third-party-notices.txt"]
  }
}
