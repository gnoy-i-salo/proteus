specification {
  element module
  element runtime
  element external
  element component
  element store { style { shape storage } }
  relationship source-flow
  // Proposed elements are documentation, not implemented workspace packages.
  element proposed-component {
    style { color amber }
  }
  element proposed-store {
    style {
      color amber
      shape storage
    }
  }
  element proposed-external {
    style { color muted }
  }
  relationship proposed-flow
}

model {
  pipeline = module "pipeline" {
    description "Frozen task rubric and sourced profiles → frozen personas and neutral control → repeated blinded answer evaluation → deterministic BSC v2 intervals. Timing, failed attempts and evidence uncertainty remain separate."
    metadata {
      package "@proteus-int/pipeline"
      path "packages/pipeline"
    }
  }
  native-host = runtime "Native CLI broker" {
    description "Tauri IPC: bounded CLI execution, cancellation, observable events, local artifacts and native .proteus preset dialogs/file associations. Credentials remain with installed CLIs."
  }
  codex-cli = external "Installed Codex CLI"
  kimi-cli = external "Installed Kimi CLI"
  desktop = module "desktop" {
    metadata {
      package "@proteus-int/desktop"
      path "apps/desktop"
    }
  }
  brain-analyzator = module "brain-analyzator" {
    description "Creates a task-only rubric before answers, then evaluates anonymous answer content against anchored criteria without timing or persona metadata."
    metadata {
      package "@proteus-int/brain-analyzator"
      path "packages/brain-analyzator"
    }
  }
  brain-scoring = module "brain-scoring" {
    description "Deterministic BSC v2 weighted attainment intervals, critical-constraint gates, median summaries and baseline differences. Legacy BSC v1 remains available for history."
    metadata {
      package "@proteus-int/brain-scoring"
      path "packages/brain-scoring"
    }
  }
  contracts = module "contracts" {
    metadata {
      package "@proteus-int/contracts"
      path "packages/contracts"
    }
  }
  intelligence = module "intelligence" {
    metadata {
      package "@proteus-int/intelligence"
      path "packages/intelligence"
    }
  }
  person = module "person" {
    metadata {
      package "@proteus-int/person"
      path "packages/person"
    }
  }
  person-fabric = module "person-fabric" {
    metadata {
      package "@proteus-int/person-fabric"
      path "packages/person-fabric"
    }
  }
  stalker = module "stalker" {
    metadata {
      package "@proteus-int/stalker"
      path "packages/stalker"
    }
  }
  desktop -> contracts "imports"
  desktop -> intelligence "imports"
  desktop -> pipeline "imports"
  pipeline -> contracts "imports"
  pipeline -> intelligence "imports"
  pipeline -> stalker "imports"
  pipeline -> person-fabric "imports"
  pipeline -> person "imports"
  pipeline -> brain-scoring "imports"
  pipeline -> brain-analyzator "imports"
  desktop -> native-host "invoke / events / cancel"
  native-host -> codex-cli "exec --json; read-only"
  native-host -> kimi-cli "Print-mode JSONL; explicit agent instructions and tool allowlist; reasoning unavailable"
  brain-analyzator -> contracts "imports"
  brain-analyzator -> intelligence "imports"
  brain-scoring -> contracts "imports"
  intelligence -> contracts "imports"
  person -> contracts "imports"
  person -> intelligence "imports"
  person-fabric -> contracts "imports"
  person-fabric -> intelligence "imports"
  person-fabric -> stalker "imports"
  person-fabric -> person "imports"
  stalker -> contracts "imports"
  stalker -> intelligence "imports"

  pages-site = runtime "GitHub Pages static artifact" {
    description "One build artifact with /proteus/auth/ and /proteus/architecture/, published by the Pages workflow after checks. Static hosting only; no OAuth token-exchange backend or corpus uploads."
  }
  auth = module "auth · VK callback SPA" {
    description "Static SolidJS callback bridge at /proteus/auth/. Validates the response shape, clears browser URL parameters, and offers a fixed versioned native handoff. No token exchange, secrets, analytics or persistent storage. Native state matching, single-use PKCE transactions and token exchange run inside desktop."
    metadata {
      package "@proteus-int/auth"
      path "apps/auth"
    }
  }
  diagrams-site = runtime "LikeC4 static site" {
    description "Static documentation at /proteus/architecture/. Current package dependencies and proposed runtime views remain explicitly separate."
  }
  source-sources = component "native source service" {
    description "Rust inside the desktop application: authoritative connection, resource/time scope, capability and budget checks; bounded reads, checkpoints, cancellation and source snapshots. Only typed read operations for authorized sources; no send/delete, arbitrary HTTP, shell or token/cookie export. API-first; no application Node server or required MCP bridge. Provider registration and granted API capabilities determine actual available data."
  }
  source-skills = component "source skills" {
    description "Bundled instructions under packages/stalker/skills/<skill-name>/SKILL.md, telegram-research, vk-research, instagram-research and github-research, bundled at build time. Skills guide source selection and interpretation; they cannot grant capabilities, extend selected resources or access credentials."
    telegram = component "Telegram skill" {
      description "Use only selected, permitted Telegram resources through the typed TDLib adapter; respect platform restrictions and report missing coverage."
    }
    vk = component "VK skill" {
      description "Use only capabilities actually granted to the connected VK account; identity authorization is not social-data permission."
    }
    instagram = component "Instagram skill" {
      description "Choose available import, own professional-account API or explicitly supported experimental reader; never claim arbitrary profile access."
    }
    github = component "GitHub skill" {
      description "Collect permitted selected repository/account material; retain authorship, review and discussion context."
    }
  }
  source-source-controller = component "STALKER collection controller" {
    description "Bounded agent loop: ask the selected existing CLI for structured next-action JSON, validate the requested typed SourcePort operation, call Rust, and feed back a bounded sanitized result. Explicit native CLI policy disables inherited tools; JSON alone is not isolation. Skills cannot grant permissions. Track steps, bytes, elapsed time, checkpoints and cancellation; never escalate selected scope."
  }
  source-source-analysis = component "STALKER evidence analysis" {
    description "Separate post-collection/import phase over frozen sanitized chunks. Disable CLI tools, inherited MCP/user tools and web search; no source operations. Model-provider inference still uses its network. Build task-free observations with exact opaque evidence references, uncertainty, contradictions and coverage before Fabric."
  }
  source-telegram = component "Telegram / TDLib adapter" {
    description "Native user authorization and selected accessible material. Collection and model processing are gated by platform terms and permission; no claim of arbitrary user history or unrestricted AI use."
  }
  source-vk = component "VK adapter" {
    description "VK ID connection and VK API capabilities are validated separately. Granted identity scopes do not imply wall, comments or other social-data access."
  }
  source-github = component "GitHub adapter" {
    description "Public API first; optional native device authorization for supported access. Attribute commits, reviews and discussions to their authors; repository ownership is not authorship."
  }
  source-import = component "file / Instagram import" {
    description "User-selected exports, full chats, posts, comments and saved pages. Parse authors, quotes, dates and attachments; mark missing content. Instagram API access is limited to supported account capabilities, not arbitrary personal profiles."
  }
  source-instagram-api = component "Optional Instagram professional API" {
    description "Optional administrator setup for the user's own supported Business/Creator account: App Dashboard token stored and refreshed natively where supported. General end-user OAuth requiring a confidential backend is outside this serverless baseline."
  }
  planned-reader = proposed-component "Experimental isolated page reader" {
    description "Not implemented. Optional visible, isolated browser/WebView acquisition for specifically supported pages. No application IPC privileges or credential export; no bypass of access controls. Browser support and platform terms remain release gates. Not a universal Playwright integration."
  }
  source-credentials = store "native credential store" {
    description "OS-protected provider credentials and native session references. No secrets in renderer, prompts, traces, presets or exports. Installed Codex/Kimi CLI authentication remains untouched."
  }
  source-corpus = store "local source corpus" {
    description "Bounded local snapshots and chunks with source IDs, authors, dates, hashes, provenance and coverage. Preserve original message boundaries, reply context, line breaks, casing, punctuation and emoji; distinguish the target author's text from quotes, forwards and other speakers. Raw chats stay outside .proteus presets and result JSON; explicit retention and deletion."
  }
  source-input-redaction = component "model-input preparation" {
    description "Resolve target authors and remove direct identifiers before model analysis while preserving message boundaries and textual formatting around redaction placeholders, opaque quote references and coverage. Supplied private-material analysis has tools disabled and no external searches."
  }
  source-redaction = component "evidence redaction boundary" {
    description "Validate factual excerpt references, preserve facts versus hypotheses and contradictions, then pass anonymized factual summaries without original quotes to Person Fabric. A separate style boundary may admit permitted, sanitized exemplars. Retrieval is not proof of truth or personal ability."
  }
  source-style-split = component "reference / holdout split" {
    description "Native readers reserve independent GitHub threads by a stable hash; single-conversation sources report no independent holdout. Exclude marked holdout documents and duplicate content hashes before analysis. Preserve dialogue context and verbatim formatting after identifier redaction. Holdout messages and their overlapping contexts never enter profiling, Fabric or exemplars. Record split provenance and coverage for each mode."
  }
  source-style-extraction = component "observable style and rhetoric" {
    description "Tools-off extraction from the reference split: vocabulary, message length, casing, punctuation, emoji, line breaks, turn-taking and visible argument patterns such as questions, examples, objections and revisions. Distinguish dialogue, comment and formal-task modes. Describe observable text behavior, not hidden thoughts or proven mental traits; mark unsupported patterns unknown."
  }
  source-style-boundary = component "style exemplar boundary" {
    description "Validate author and source references, usage permission and direct-identifier redaction. Admit only bounded permitted exemplars and evidence-linked style rules, preserving remaining wording and formatting. Other speakers and quoted text remain context, not persona samples. Exemplar data cannot introduce instructions or new permissions."
  }
  source-frozen-persona = store "frozen persona and style profile" {
    description "Fabric composes behavioral rules, observable rhetoric, context-specific dialogue/comment/formal-task modes and sanitized exemplars. Freeze profile, exemplar IDs and split version before repeats; task adaptation cannot rewrite this style baseline. Missing mode evidence stays explicit. Close stylistic fidelity is a goal, not a guarantee of a 1:1 person or their thinking."
  }
  source-persona-output = component "faithful text rendering" {
    description "Person emits the selected context mode and ordered messages with model-generated line breaks, casing, punctuation and emoji preserved by validation and rendering. No automatic formalization, capitalization repair, Markdown normalization or merging of message boundaries. Output remains an identified simulation, not a claim to be the source person."
  }
  planned-fidelity = proposed-component "Planned held-out fidelity evaluation" {
    description "Not implemented. Separate style/rhetoric evaluation against unseen, context-matched source-authored holdout messages: formatting features, argument moves, mode coverage and blind human/model review with limitations. Evaluation cannot feed held-out examples back into the frozen profile. Report fidelity separately from task quality and deterministic BSC; no automatic 1:1 guarantee."
  }
  source-browser = external "User browser · auth flow"
  source-vk-id = external "VK ID / token endpoint"
  source-files = external "User-selected exports and pages"

  auth -> contracts "imports"
  pages-site -> auth "serves /proteus/auth/"
  pages-site -> diagrams-site "serves /proteus/architecture/"
  desktop -[source-flow]-> source-sources "add materials / connection status"
  desktop -[source-flow]-> source-source-controller "collect within selected scope"
  stalker -[source-flow]-> source-source-controller "collection phase"
  stalker -[source-flow]-> source-source-analysis "evidence analysis phase"
  source-skills.telegram -[source-flow]-> source-source-controller "source instructions"
  source-skills.vk -[source-flow]-> source-source-controller "source instructions"
  source-skills.instagram -[source-flow]-> source-source-controller "source instructions"
  source-skills.github -[source-flow]-> source-source-controller "source instructions"
  source-source-controller -[source-flow]-> intelligence "bounded context; CLI tools off"
  intelligence -[source-flow]-> source-source-controller "next-action JSON or finish"
  source-source-controller -[source-flow]-> source-sources "validated typed SourcePort read"
  source-sources -[source-flow]-> source-source-controller "bounded sanitized result / status"
  source-sources -[source-flow]-> source-corpus "native snapshots and checkpoints"
  native-host -[source-flow]-> source-sources "in-process Rust integration"
  source-sources -[source-flow]-> source-browser "provider authorization"
  source-browser -[source-flow]-> auth "complete VK login to HTTPS callback"
  auth -[source-flow]-> source-sources "Native receiver: code + state; never tokens"
  source-sources -[source-flow]-> source-credentials "native credentials only"
  source-sources -[source-flow]-> source-telegram "supported Telegram acquisition"
  source-sources -[source-flow]-> source-vk "granted VK capabilities"
  source-sources -[source-flow]-> source-github "public / permitted GitHub data"
  source-sources -[source-flow]-> source-import "selected export ingestion"
  source-sources -[source-flow]-> source-instagram-api "optional own professional account"
  source-sources -[proposed-flow]-> planned-reader "Planned: optional supported-page read"
  source-files -[source-flow]-> source-import "explicit file selection"
  source-telegram -[source-flow]-> source-corpus "bounded source snapshots"
  source-vk -[source-flow]-> source-corpus "bounded source snapshots"
  source-github -[source-flow]-> source-corpus "attributed source snapshots"
  source-import -[source-flow]-> source-corpus "parsed messages and coverage"
  source-instagram-api -[source-flow]-> source-corpus "supported own-account material"
  planned-reader -[proposed-flow]-> source-corpus "Planned: captured visible material"
  source-corpus -[source-flow]-> source-input-redaction "bounded chunks; opaque references"
  source-style-split -[source-flow]-> source-source-analysis "reference chunks; tools and search off"
  source-source-analysis -[source-flow]-> source-redaction "sourced observations and limitations"
  source-redaction -[source-flow]-> person-fabric "anonymized factual summaries"
  source-input-redaction -[source-flow]-> source-style-split "attributed text; formatting preserved"
  source-style-split -[source-flow]-> source-style-extraction "reference split only"
  source-style-extraction -[source-flow]-> source-style-boundary "observable rules and referenced excerpts"
  source-style-boundary -[source-flow]-> person-fabric "style profile and permitted sanitized exemplars"
  person-fabric -[source-flow]-> source-frozen-persona "freeze behavior, modes and exemplars"
  source-frozen-persona -[source-flow]-> person "fixed profile across repeats"
  person -[source-flow]-> source-persona-output "mode-specific ordered messages"
  source-persona-output -[proposed-flow]-> planned-fidelity "Planned: assess generated text separately from BSC"
  source-style-split -[proposed-flow]-> planned-fidelity "Planned: unseen holdout; never supplied to Fabric"
}

views {
  view modules {
    title "Current implementation · package dependencies"
    description "Implemented packages and runtime boundaries only. Source components are expanded in dedicated views; this checked view shows workspace dependencies."
    include * where kind is module or kind is runtime or kind is external
    autoLayout LeftRight
  }
  view index extends modules {
    title "PROTEUS · current implementation"
    description "Start with the implemented architecture. Amber proposed elements in detailed views describe future work, not existing packages or deployed services."
  }
  view source-architecture {
    title "Source acquisition and local analysis"
    description "Implemented source adapters; amber components remain future work. One desktop application; provider-specific capabilities and permissions determine availability. Existing package dependencies remain unchanged."
    include desktop, native-host, source-sources, source-credentials, source-skills, source-source-controller,
      source-telegram, source-vk, source-github, source-import, source-instagram-api, planned-reader,
      source-files, source-corpus, source-input-redaction, source-style-split, stalker, source-source-analysis,
      source-redaction, person-fabric
    exclude * -> * where kind is not source-flow and kind is not proposed-flow
    autoLayout LeftRight
  }
  view source-agent {
    title "Bounded STALKER source-agent loop"
    description "The model proposes a structured next action; the STALKER controller and native SourcePort enforce authorization, read-only capabilities and budgets. No native CLI tool expansion or MCP is required. Collection is separate from tools-off analysis of the frozen corpus."
    include desktop, stalker, source-skills.*, source-source-controller, intelligence,
      source-sources, source-corpus, source-input-redaction, source-style-split, source-source-analysis,
      source-redaction, person-fabric
    exclude * -> * where kind is not source-flow and kind is not proposed-flow
    autoLayout LeftRight
  }
  view persona-style {
    title "Observable persona style · fidelity evaluation planned"
    description "Preserve source-authored dialogue/comment formatting and observable rhetoric through permitted sanitized exemplars. Freeze context-specific profiles before repeats and evaluate against unseen holdout text separately from BSC. 1:1 fidelity is a target to assess, not a promised reconstruction of a person's mind."
    include source-corpus, source-input-redaction, source-style-split,
      source-style-extraction, source-style-boundary, source-source-analysis,
      source-redaction, person-fabric, source-frozen-persona, person,
      source-persona-output, planned-fidelity
    exclude * -> * where kind is not source-flow and kind is not proposed-flow
    autoLayout LeftRight
  }
  view static-hosting {
    title "Static hosting · auth SPA and LikeC4"
    description "One Pages artifact, two static paths. The callback SPA hands authorization responses to the native single-use PKCE receiver. The documentation host does not process source material."
    include pages-site, auth, diagrams-site, source-browser,
      source-sources, source-credentials
    autoLayout LeftRight
  }
  dynamic view source-vk-authorization {
    title "VK connection through a static callback"
    description "Native flow requires a configured VK application and matching redirect URI. Live account authorization must be checked with the user’s registration. VK login alone does not grant social-data access. Cancellation, mismatch or expiry ends the pending transaction."
    desktop -> source-sources "Connect VK; create expiring single-use transaction"
    source-sources -> source-browser "Open VK authorization with state and PKCE challenge"
    source-browser -> source-vk-id "User signs in and reviews requested permissions"
    source-vk-id -> source-browser "Redirect authorization code, state and device_id"
    source-browser -> auth "Open registered HTTPS callback at /proteus/auth/"
    auth -> source-sources "Return allowlisted response to fixed native callback"
    source-sources -> source-sources "Validate state, expiry, redirect and single use"
    source-sources -> source-vk-id "Exchange code with native PKCE verifier and device_id"
    source-vk-id -> source-sources "Return tokens only to native application"
    source-sources -> source-credentials "Store credentials with OS protection"
    source-sources -> desktop "Report granted capabilities; never expose tokens"
    autoLayout LeftRight
  }
}
