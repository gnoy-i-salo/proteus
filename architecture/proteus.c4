specification {
  element module
  element runtime
  element external
}

model {
  pipeline = module "pipeline" {
    description "Two public profiles → evidence → archetypes and skills → task attempts → BSC → comparison. Cancellation and failures preserve completed stages."
    metadata {
      package "@proteus-int/pipeline"
      path "packages/pipeline"
    }
  }
  native-host = runtime "Native CLI broker" {
    description "Tauri IPC: bounded CLI execution, cancellation, observable events and local artifacts. Credentials remain with installed CLIs."
  }
  codex-cli = external "Installed Codex CLI"
  kimi-cli = external "Installed Kimi CLI"
  desktop = module "desktop" {
    metadata {
      package "@proteus-int/desktop"
      path "apps/desktop"
    }
  }
  brain-analyzator = module "brain-analyzator" {
    metadata {
      package "@proteus-int/brain-analyzator"
      path "packages/brain-analyzator"
    }
  }
  brain-scoring = module "brain-scoring" {
    metadata {
      package "@proteus-int/brain-scoring"
      path "packages/brain-scoring"
    }
  }
  contracts = module "contracts" {
    metadata {
      package "@proteus-int/contracts"
      path "packages/contracts"
    }
  }
  intelligence = module "intelligence" {
    metadata {
      package "@proteus-int/intelligence"
      path "packages/intelligence"
    }
  }
  person = module "person" {
    metadata {
      package "@proteus-int/person"
      path "packages/person"
    }
  }
  person-fabric = module "person-fabric" {
    metadata {
      package "@proteus-int/person-fabric"
      path "packages/person-fabric"
    }
  }
  stalker = module "stalker" {
    metadata {
      package "@proteus-int/stalker"
      path "packages/stalker"
    }
  }
  desktop -> contracts "imports"
  desktop -> intelligence "imports"
  desktop -> pipeline "imports"
  pipeline -> contracts "imports"
  pipeline -> intelligence "imports"
  pipeline -> stalker "imports"
  pipeline -> person-fabric "imports"
  pipeline -> person "imports"
  pipeline -> brain-scoring "imports"
  pipeline -> brain-analyzator "imports"
  desktop -> native-host "invoke / events / cancel"
  native-host -> codex-cli "exec --json; read-only"
  native-host -> kimi-cli "ACP JSON-RPC; thinking chunks; explicit tool allowlist"
  brain-analyzator -> contracts "imports"
  brain-analyzator -> intelligence "imports"
  brain-analyzator -> brain-scoring "imports"
  brain-scoring -> contracts "imports"
  intelligence -> contracts "imports"
  person -> contracts "imports"
  person -> intelligence "imports"
  person-fabric -> contracts "imports"
  person-fabric -> intelligence "imports"
  person-fabric -> stalker "imports"
  person-fabric -> person "imports"
  stalker -> contracts "imports"
  stalker -> intelligence "imports"
}

views {
  view modules {
    include *
    autoLayout LeftRight
  }
}
