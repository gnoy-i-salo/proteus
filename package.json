{
  "name": "@proteus-int/workspace",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": "11.9.0"
  },
  "scripts": {
    "prepare": "husky",
    "dev": "pnpm --filter @proteus-int/desktop dev",
    "dev:auth": "pnpm --filter @proteus-int/auth dev",
    "desktop": "pnpm --filter @proteus-int/desktop tauri dev",
    "build": "pnpm -r build",
    "build:pages": "node scripts/build-pages.mjs",
    "prepare:tdlib": "node scripts/prepare-tdlib.mjs",
    "build:desktop": "pnpm --filter @proteus-int/desktop tauri build --no-bundle -- --locked",
    "lint": "eslint . --max-warnings=0",
    "lint:styles": "stylelint 'apps/**/*.scss'",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r typecheck && tsc -p tooling/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:harness": "node --test scripts/*.test.mjs",
    "test:e2e": "playwright test",
    "architecture": "likec4 start architecture",
    "architecture:export": "likec4 export json --skip-layout --pretty -o .cache/architecture.json architecture",
    "check:architecture": "pnpm architecture:export && node scripts/check-architecture.mjs",
    "check:naming": "node scripts/check-naming.mjs",
    "check": "node scripts/check.mjs --all",
    "check:changed": "node scripts/check.mjs --changed",
    "check:staged": "node scripts/check.mjs --staged",
    "check:package": "node scripts/check.mjs --package",
    "check:rust": "cargo fmt --manifest-path apps/desktop/src-tauri/Cargo.toml -- --check && cargo clippy --locked --manifest-path apps/desktop/src-tauri/Cargo.toml --all-targets -- -D warnings && cargo test --locked --manifest-path apps/desktop/src-tauri/Cargo.toml",
    "commitlint": "commitlint",
    "beads:init": "bd init --prefix proteus --skip-hooks --skip-agents --non-interactive --init-if-missing",
    "beads:ready": "bd ready --json",
    "bundle:macos": "pnpm --filter @proteus-int/desktop tauri build --bundles app -- --locked"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.3.1",
    "@commitlint/config-conventional": "^20.3.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.58.1",
    "@types/node": "^24.10.9",
    "eslint": "^10.14.0",
    "eslint-plugin-solid": "^0.18.1",
    "globals": "^17.3.0",
    "husky": "^9.1.7",
    "likec4": "1.60.0",
    "prettier": "^3.8.1",
    "sass": "^1.97.3",
    "stylelint": "^16.26.1",
    "stylelint-config-standard-scss": "^16.0.0",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.54.0",
    "vite": "^7.3.1",
    "vite-plugin-solid": "^2.11.10",
    "vitest": "^4.0.18"
  }
}
